{
  "name": "@syndic/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "auth:generate": "auth generate --config src/auth.ts --output ../../packages/db/src/schema/auth.ts --yes",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "auth": "1.7.17",
    "esbuild": "^0.28.2",
    "pdfjs-dist": "^6.5.438",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@aws-sdk/s3-request-presigner": "^3.1164.0",
    "@better-auth/expo": "1.7.17",
    "@hono/node-server": "^2.1.6",
    "@pdf-lib/fontkit": "^1.1.1",
    "@syndic/db": "workspace:*",
    "@syndic/shared": "workspace:*",
    "bcryptjs": "3.0.3",
    "better-auth": "1.7.17",
    "dotenv": "^18.0.9",
    "drizzle-orm": "0.45.4",
    "hono": "^4.13.16",
    "pdf-lib": "^1.17.1",
    "zod": "^4.6.7"
  }
}
