# Copier ce fichier en .env.local (non versionné) et renseigner les valeurs.

# Chaîne de connexion Neon, branche dev uniquement en développement.
DATABASE_URL=

# Port de l'API Hono (3000 par défaut).
PORT=

# Environnement : development en local (active CORS et les origines exp:// d’Expo Go).
# Absent ou vide = production.
NODE_ENV=

# Better Auth : secret de signature des sessions (32 caractères minimum, ex. openssl rand -base64 32).
BETTER_AUTH_SECRET=

# Better Auth : URL publique de l’API (ex. http://localhost:3000).
BETTER_AUTH_URL=
