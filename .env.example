# Copier ce fichier en .env.local (non versionné) et renseigner les valeurs.

# Chaîne de connexion Neon, branche dev uniquement en développement.
DATABASE_URL=

# Port de l'API Hono (3000 par défaut).
PORT=

# Environnement : development en local (active CORS et les origines exp:// d’Expo Go).
# Absent ou vide = production.
NODE_ENV=

# Better Auth : secret de signature des sessions (32 caractères minimum, ex. openssl rand -base64 32).
BETTER_AUTH_SECRET=

# Better Auth : URL publique de l’API (ex. http://localhost:3000).
BETTER_AUTH_URL=

# Derrière le proxy de l'hébergeur uniquement : en-tête qui porte l'IP du client (ex. x-forwarded-for).
# Vide en local : l'IP de la connexion est utilisée pour limiter les tentatives de connexion.
CLIENT_IP_HEADER=

# Appli mobile (dans apps/mobile/.env.local) : URL de l'API vue depuis le téléphone,
# c'est-à-dire l'adresse IP locale de l'ordinateur (ex. http://192.168.1.10:3000), pas localhost.
EXPO_PUBLIC_API_URL=
